# Copia este archivo a .env y llena los valores; .env nunca se versiona.
# Para cargarlo al correr un comando: uv run --env-file .env <comando>

# Clave de la API de Anthropic. Solo hace falta si el proyecto llama al modelo por la API;
# con `claude -p` no hace falta (ver evals/README.md).
ANTHROPIC_API_KEY=
